from typing import Optional, TYPE_CHECKING

from sqlmodel import SQLModel, Field, Relationship

if TYPE_CHECKING:
    from .pelea import Pelea
    from .pila import Pila


class Jugador(SQLModel, table=True):
    id: Optional[int] = Field(default=None, primary_key=True)

    tipo: str = Field(default="jugador")

    vida: int = Field(default=100, ge=0, le=100)
    energia: int = Field(default=50, ge=0, le=50)

    # Relación con Pelea
    id_pelea: Optional[int] = Field(
        default=None,
        foreign_key="pelea.id"
    )
    pelea: Optional["Pelea"] = Relationship(
        back_populates="jugadores"
    )

    # Relación con Pila
    pila: Optional["Pila"] = Relationship(
        back_populates="jugador"

    )



class JugadorUpdate(SQLModel):
    vida: int | None = Field(default=None, ge=0, le=100)
    energia: int | None = Field(default=None, ge=0, le=50)
    

class Maquina(Jugador):
    tipo: str = "maquina"

    

class Persona(Jugador):
    tipo: str = "persona"
    username: str = Field(unique=True, index=True)


Repositories
from sqlmodel import select
from models.jugador import Jugador
from database.database import get_session



def crear_jugador(jugador: Jugador):
    with get_session() as session:
        session.add(jugador)
        session.commit()
        session.refresh(jugador)

        return jugador



# Obtener todos los jugadores
def get_jugadores():
    with get_session() as session:
        statement = select(Jugador)
        return session.exec(statement).all()


# Obtener un jugador por ID
def get_jugador_id(id: int):
    with get_session() as session:
        statement = select(Jugador).where(Jugador.id == id)
        return session.exec(statement).first()


# Obtener todos los nombres de los jugadores
def get_nombres_jugadores():
    with get_session() as session:
        statement = select(Jugador.tipo, Jugador.id)
        return session.exec(statement).all()

def get_personas():
    with get_session() as session:
        statement = select(Jugador).where(
            Jugador.tipo == "persona"
        )
        return session.exec(statement).all()


def get_maquinas():
    with get_session() as session:
        statement = select(Jugador).where(
            Jugador.tipo == "maquina"
        )
        return session.exec(statement).all()



def eliminar_jugador(jugador_id: int):
    with get_session() as session:

        jugador = session.get(Jugador, jugador_id)

        if jugador is None:
            return {"message": "Jugador no encontrado"}

        session.delete(jugador)
        session.commit()

        return {"ok": True}
    


def modificar_jugador(jugador_id: int, datos: dict):
    with get_session() as session:

        jugador_db = session.get(Jugador, jugador_id)

        if jugador_db is None:
            return {"message": "Jugador no encontrado"}

        datos_permitidos = {"vida", "energia"}

        update_data = {
            clave: valor
            for clave, valor in datos.items()
            if clave in datos_permitidos
        }

        jugador_db.sqlmodel_update(update_data)

        session.add(jugador_db)
        session.commit()
        session.refresh(jugador_db)

