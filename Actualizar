# PUT: Modificar jugador
@router.put("/{id}")
def actualizar_jugador(id: int, datos: JugadorUpdate):
    resultado = modificar_jugador(
        id,
        datos.model_dump(exclude_unset=True)
    )

    if resultado is None:
        raise HTTPException(404, "Jugador no encontrado")

    return resultado


# DELETE: Eliminar jugador
@router.delete("/{id}")
def borrar_jugador(id: int):
    resultado = eliminar_jugador(id)

    if not resultado.get("ok"):
        raise HTTPException(404, "Jugador no encontrado")

    return resultado

